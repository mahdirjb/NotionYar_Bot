# Telegram and Notion
BOT_TOKEN=
NOTION_TOKEN=
NOTION_DBID_TIME_TRACKER=
NOTION_DBID_LIFE_TRACKER=
NOTION_DBID_HABITS=
NOTION_DBID_SALAH=
NOTION_DBID_QURAN=
NOTION_LIFE_TRACKER_INTERVALS_PAGE_ID=

# Telegram users
ADMIN_USERS=
MANAGER_USERS=
MEMBER_USERS=
GUEST_USERS=

# Public web deployment
WEBAPP_URL=https://notionyar.example.com
ALLOWED_HOSTS=notionyar.example.com
CORS_ORIGINS=https://notionyar.example.com
PORT=8000

# Standalone web login
WEB_LOGIN_USERNAME=admin
WEB_LOGIN_PASSWORD_HASH=pbkdf2_sha256$600000$replace_with_salt$replace_with_digest
WEB_SESSION_SECRET=replace_with_at_least_32_random_characters
WEB_SESSION_DAYS=30
WEB_COOKIE_SECURE=true
# Mount a Railway Volume at /app/data and use this path in production.
WEB_CREDENTIALS_FILE=/app/data/web_credentials.json

# Never enable this in production
ALLOW_DEV_BYPASS=false
